<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /daybook/

  # If the request is for a real file or folder that exists (e.g. an
  # asset like /daybook/assets/index-abc123.js), serve it directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise (any app route like /login, /employee, /task/123), serve
  # index.html and let React Router handle it client-side.
  RewriteRule ^ index.html [L]
</IfModule>